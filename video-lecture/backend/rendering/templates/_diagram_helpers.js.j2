/* ── Diagram Validity Guard ──────────────────────────────────
   Returns true only if DIAGRAM_DATA has at least 1 region with a valid bbox.
   Used to prevent phantom annotations on non-diagram scenes. */
function hasValidDiagram() {
  var dd = window.DIAGRAM_DATA;
  if (!dd) return false;
  var regions = dd.regions || dd.components || dd.elements || [];
  if (regions.length === 0) return false;
  // Verify at least one region has a real bbox
  for (var i = 0; i < regions.length; i++) {
    var r = regions[i];
    if (r.bbox || (r.x_pct !== undefined && r.y_pct !== undefined)) return true;
  }
  return false;
}

// Expose all helpers globally
window.zoomToRegion = zoomToRegion;
window.zoomOut = zoomOut;
window.drawCircleAnnotation = drawCircleAnnotation;
window.drawHighlightBox = drawHighlightBox;
window.drawFlowArrow = drawFlowArrow;
window.drawEdgeHighlight = drawEdgeHighlight;
window.drawEdgeLine = drawEdgeLine;
window.drawAllEdgesForRegion = drawAllEdgesForRegion;
window.moveCursor = moveCursor;
window.clearAnnotations = clearAnnotations;
window.hasValidDiagram = hasValidDiagram;
window.regionToPixels = regionToPixels;

