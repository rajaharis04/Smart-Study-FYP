// ── Diagram Intelligence Variables ──────────────────────────
let diagramImgEl = document.getElementById('diagram-img');
let annotationSVG = document.getElementById('annotation-svg') || document.getElementById('diagram-svg-overlay');
let cursorDot = document.getElementById('cursor-dot');

function getDiagramCoords(region) {
  if (!diagramImgEl) diagramImgEl = document.getElementById('diagram-img');
  if (!diagramImgEl) return null;
  if (!annotationSVG) annotationSVG = document.getElementById('diagram-svg-overlay') || document.getElementById('annotation-svg');
  
  const w = diagramImgEl.offsetWidth || diagramImgEl.naturalWidth || 500;
  const h = diagramImgEl.offsetHeight || diagramImgEl.naturalHeight || 400;
  
  let ox = 0;
  let oy = 0;
  if (diagramImgEl && annotationSVG) {
    const ir = diagramImgEl.getBoundingClientRect();
    const sr = annotationSVG.getBoundingClientRect();
    ox = ir.left - sr.left;
    oy = ir.top - sr.top;
  }
  
  return {
    x: region.x_pct * w + ox,
    y: region.y_pct * h + oy,
    w: region.w_pct * w,
    h: region.h_pct * h,
    cx: (region.x_pct + region.w_pct / 2) * w + ox,
    cy: (region.y_pct + region.h_pct / 2) * h + oy
  };
}

function regionToPixels(region) {
  const coords = getDiagramCoords(region);
  return coords || { x: 0, y: 0, w: 0, h: 0, cx: 0, cy: 0 };
}

function zoomToRegion(region, scale, durationSec) {
  const wrapper = document.getElementById('diagram-zoom-wrapper') || document.getElementById('diagram-viewport') || document.getElementById('diagram-zoom-target') || document.getElementById('diagram-wrapper');
  if (!wrapper) return;
  if (!diagramImgEl) diagramImgEl = document.getElementById('diagram-img');
  if (!diagramImgEl) return;
  
  // Enforce very subtle 3% zoom
  const sc = 1.03;
  
  const w = diagramImgEl.offsetWidth || diagramImgEl.naturalWidth || 500;
  const h = diagramImgEl.offsetHeight || diagramImgEl.naturalHeight || 400;
  
  const regionCX = (region.x_pct + region.w_pct / 2) * w;
  const regionCY = (region.y_pct + region.h_pct / 2) * h;
  const imgCX = w / 2;
  const imgCY = h / 2;
  
  // Enforce subtle 5% translation nudge to keep it extremely subtle
  const targetX = (imgCX - regionCX) * sc * 0.05;
  const targetY = (imgCY - regionCY) * sc * 0.05;
  
  if (typeof gsap !== 'undefined') {
      gsap.to(wrapper, {
        scale: sc,
        x: targetX,
        y: targetY,
        duration: durationSec || 0.9,
        ease: 'power3.inOut'
      });
  }
}

function zoomOut(durationSec) {
  const wrapper = document.getElementById('diagram-zoom-wrapper') || document.getElementById('diagram-viewport') || document.getElementById('diagram-zoom-target') || document.getElementById('diagram-wrapper');
  if (!wrapper) return;
  if (typeof gsap !== 'undefined') {
      gsap.to(wrapper, { scale: 1, x: 0, y: 0, duration: durationSec || 0.8, ease: 'power2.inOut' });
  }
}

function drawCircleAnnotation(region, color) {
  if (!annotationSVG) annotationSVG = document.getElementById('diagram-svg-overlay') || document.getElementById('annotation-svg');
  if (!annotationSVG) return;
  
  const coords = getDiagramCoords(region);
  if (!coords) return;
  
  const rx = coords.w / 2 + 10;
  const ry = coords.h / 2 + 10;
  
  const circ = document.createElementNS('http://www.w3.org/2000/svg','ellipse');
  circ.setAttribute('cx', coords.cx);
  circ.setAttribute('cy', coords.cy);
  circ.setAttribute('rx', rx);
  circ.setAttribute('ry', ry);
  circ.setAttribute('fill','none');
  circ.setAttribute('stroke', color || '#FF6B35');
  circ.setAttribute('stroke-width','2');
  circ.setAttribute('opacity','0');
  
  const perim = 2 * Math.PI * Math.sqrt((rx*rx+ry*ry)/2);
  circ.setAttribute('stroke-dasharray', perim);
  circ.setAttribute('stroke-dashoffset', perim);
  circ.setAttribute('filter', 'drop-shadow(0 0 6px ' + (color || '#FF6B35') + ')');
  annotationSVG.appendChild(circ);
  
  if (typeof gsap !== 'undefined') {
      gsap.to(circ, { opacity:1, strokeDashoffset:0, duration:1.3, ease:'power2.out' });
      setTimeout(() => { gsap.to(circ, { opacity:0, duration:0.4, onComplete:()=>circ.remove() }); }, 4000);
  } else {
      circ.style.opacity = '1';
      circ.style.strokeDashoffset = '0';
      setTimeout(() => circ.remove(), 4000);
  }
}

function drawHighlightBox(region, color) {
  if (!annotationSVG) annotationSVG = document.getElementById('diagram-svg-overlay') || document.getElementById('annotation-svg');
  if (!annotationSVG) return;
  
  const coords = getDiagramCoords(region);
  if (!coords) return;
  
  const rect = document.createElementNS('http://www.w3.org/2000/svg','rect');
  rect.setAttribute('x', coords.x - 6);
  rect.setAttribute('y', coords.y - 6);
  rect.setAttribute('width', coords.w + 12);
  rect.setAttribute('height', coords.h + 12);
  rect.setAttribute('rx','6');
  rect.setAttribute('fill', (color || '#FF4444') + '22');
  rect.setAttribute('stroke', color || '#FF4444');
  rect.setAttribute('stroke-width','2.5');
  rect.setAttribute('opacity','0');
  annotationSVG.appendChild(rect);
  
  if (typeof gsap !== 'undefined') {
      gsap.to(rect, { opacity:1, duration:0.4, ease:'power2.out',
        onComplete: () => gsap.to(rect, { opacity:1, yoyo:true, repeat:1, duration:0.5, delay:0.8,
          onComplete: () => setTimeout(()=>{ gsap.to(rect,{opacity:0,duration:0.4,onComplete:()=>rect.remove()})},3000) }) });
  } else {
      rect.style.opacity = '1';
      setTimeout(() => rect.remove(), 5500);
  }
}

/* ── Flow Arrow (Region A → Region B) ────────────────────────
   Draws a gold arrow between two regions. Only called from
   diagram_flow_arrow timeline events — NOT auto-generated. */
function drawFlowArrow(fromRegion, toRegion, label, color) {
  if (!annotationSVG) annotationSVG = document.getElementById('diagram-svg-overlay') || document.getElementById('annotation-svg');
  if (!annotationSVG) return;
  
  const fromC = getDiagramCoords(fromRegion);
  const toC = getDiagramCoords(toRegion);
  if (!fromC || !toC) return;
  
  const cx1 = fromC.cx;
  const cy1 = fromC.cy;
  const cx2 = toC.cx;
  const cy2 = toC.cy;
  
  const dx = cx2 - cx1;
  const dy = cy2 - cy1;
  const len = Math.sqrt(dx * dx + dy * dy);
  if (len < 5) return; // Nodes overlap — skip
  const ux = len > 0.001 ? dx / len : 0;
  const uy = len > 0.001 ? dy / len : 0;
  
  const hw1 = fromC.w / 2;
  const hh1 = fromC.h / 2;
  const hw2 = toC.w / 2;
  const hh2 = toC.h / 2;
  
  const t1 = Math.min(
      Math.abs(ux) > 0.001 ? hw1 / Math.abs(dx) : Infinity,
      Math.abs(uy) > 0.001 ? hh1 / Math.abs(dy) : Infinity
  );
  const t2 = Math.min(
      Math.abs(ux) > 0.001 ? hw2 / Math.abs(dx) : Infinity,
      Math.abs(uy) > 0.001 ? hh2 / Math.abs(dy) : Infinity
  );
  
  const x1 = cx1 + t1 * dx + ux * 4;
  const y1 = cy1 + t1 * dy + uy * 4;
  const x2 = cx2 - t2 * dx - ux * 6;
  const y2 = cy2 - t2 * dy - uy * 6;
  const arrowColor = color || '#FFD700';
  const markerId = 'arr_' + Date.now();
  
  let defs = annotationSVG.querySelector('defs');
  if (!defs) {
      defs = document.createElementNS('http://www.w3.org/2000/svg','defs');
      annotationSVG.insertBefore(defs, annotationSVG.firstChild);
  }
  defs.innerHTML += `<marker id="${markerId}" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M2 1L8 5L2 9" fill="none" stroke="${arrowColor}" stroke-width="1.5" stroke-linecap="round"/></marker>`;
  
  const pathLen = Math.sqrt((x2-x1)**2 + (y2-y1)**2);
  const line = document.createElementNS('http://www.w3.org/2000/svg','line');
  line.setAttribute('x1', x1); line.setAttribute('y1', y1);
  line.setAttribute('x2', x2); line.setAttribute('y2', y2);
  line.setAttribute('stroke', arrowColor); line.setAttribute('stroke-width','2');
  line.setAttribute('marker-end', `url(#${markerId})`);
  line.setAttribute('stroke-dasharray', pathLen); line.setAttribute('stroke-dashoffset', pathLen);
  line.setAttribute('opacity','0');
  annotationSVG.appendChild(line);
  
  if (typeof gsap !== 'undefined') {
      gsap.to(line, { opacity:1, strokeDashoffset:0, duration:0.8, ease:'power2.inOut' });
      if (label) {
        const txt = document.createElementNS('http://www.w3.org/2000/svg','text');
        txt.setAttribute('x', (x1+x2)/2); txt.setAttribute('y', (y1+y2)/2 - 10);
        txt.setAttribute('text-anchor','middle'); txt.setAttribute('fill', arrowColor);
        txt.setAttribute('font-size','13'); txt.setAttribute('opacity','0');
        txt.textContent = label;
        annotationSVG.appendChild(txt);
        gsap.to(txt, { opacity:1, duration:0.4, delay:0.7 });
      }
      setTimeout(()=>{ gsap.to(line, { opacity:0, duration:0.4, onComplete:()=>{ line.remove(); } }) }, 5000);
  } else {
      line.style.opacity = '1';
      line.style.strokeDashoffset = '0';
      setTimeout(() => line.remove(), 5000);
  }
}

function moveCursor(region) {
  if (!cursorDot) cursorDot = document.getElementById('cursor-dot');
  if (!cursorDot) {
      const parent = document.getElementById('diagram-zoom-target') || document.getElementById('diagram-zoom-wrapper') || document.body;
      cursorDot = document.createElement('div');
      cursorDot.id = 'cursor-dot';
      cursorDot.className = 'cursor-dot';
      cursorDot.innerHTML = '<div class="cursor-ring"></div><div class="cursor-center"></div>';
      parent.appendChild(cursorDot);
  }
  
  const coords = getDiagramCoords(region);
  if (!coords) return;
  
  cursorDot.style.display = 'block';
  if (typeof gsap !== 'undefined') {
      if (parseFloat(cursorDot.style.opacity||0) === 0) {
        gsap.set(cursorDot, { left: coords.cx, top: coords.cy, opacity: 0.8 });
      } else {
        gsap.to(cursorDot, { left: coords.cx, top: coords.cy, opacity: 0.8, duration: 0.65, ease: 'power2.inOut' });
      }
      gsap.fromTo(cursorDot, { scale: 1 }, { scale: 1.8, duration: 0.3, ease: 'power2.out',
        onComplete: () => gsap.to(cursorDot, { scale: 1, duration: 0.2 }) });
  } else {
      cursorDot.style.left = coords.cx + 'px';
      cursorDot.style.top = coords.cy + 'px';
      cursorDot.style.opacity = '0.8';
  }
}

function clearAnnotations() {
  if (annotationSVG) {
    while (annotationSVG.lastChild && annotationSVG.lastChild.tagName !== 'defs') {
      annotationSVG.removeChild(annotationSVG.lastChild);
    }
  }
  if (cursorDot && typeof gsap !== 'undefined') gsap.to(cursorDot, { opacity:0, duration:0.3 });
}

/* ── Yellow/Gold Edge Highlight ────────────────────────────────
   Draws a pulsing gold border around the active diagram region.
   Only draws where a valid bbox exists. No blinking — steady glow. */
function drawEdgeHighlight(region, color) {
  if (!annotationSVG) annotationSVG = document.getElementById('diagram-svg-overlay') || document.getElementById('annotation-svg');
  if (!annotationSVG) return;
  
  var coords = getDiagramCoords(region);
  if (!coords || coords.w < 2 || coords.h < 2) return;
  
  var edgeColor = color || '#FFD700';
  var rect = document.createElementNS('http://www.w3.org/2000/svg','rect');
  rect.setAttribute('x', coords.x - 4);
  rect.setAttribute('y', coords.y - 4);
  rect.setAttribute('width', coords.w + 8);
  rect.setAttribute('height', coords.h + 8);
  rect.setAttribute('rx','6');
  rect.setAttribute('ry','6');
  rect.setAttribute('fill','none');
  rect.setAttribute('stroke', edgeColor);
  rect.setAttribute('stroke-width','2.5');
  rect.setAttribute('opacity','0');
  rect.setAttribute('filter', 'drop-shadow(0 0 5px ' + edgeColor + ')');
  rect.classList.add('edge-highlight');
  annotationSVG.appendChild(rect);
  
  if (typeof gsap !== 'undefined') {
    // Smooth fade-in, then steady — NO pulsing/blinking
    gsap.to(rect, { opacity:1, duration:0.5, ease:'power2.out' });
    // Auto-fade after 4s
    setTimeout(function() { gsap.to(rect, { opacity:0, duration:0.5, onComplete:function(){ rect.remove(); } }); }, 4000);
  } else {
    rect.style.opacity = '1';
    setTimeout(function() { rect.remove(); }, 4000);
  }
}

