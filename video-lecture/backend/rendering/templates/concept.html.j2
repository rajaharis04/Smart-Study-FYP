<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>SmartStudyInstructor — {{ scene.topic }}</title>
    <style>
        {% include '_base.css.j2' %}

        /* Narrow bullets when diagram card is present */
        {% if scene.diagram_paths or scene._programmatic_svg %}
        .bullets-zone { max-width: 480px; }
        {% endif %}

        /* ── V16: Diagram Fullscreen Mode ──────────────────────── */
        /* When scene_mode=diagram_only OR show_left_panel is false: no left panel, right panel is 100% */
        {% if diagram_fullscreen or (show_left_panel is defined and not show_left_panel) %}
        .left-panel { display: none !important; }

        .right-panel {
            left: 0 !important;
            width: 100% !important;
        }
        .right-panel .diagram-card {
            position: relative !important;
            width: 100% !important;
            height: 85% !important;
            max-height: none !important;
            right: auto !important;
            top: auto !important;
            transform: none !important;
            opacity: 1 !important;
            margin-top: 10px;
            border-radius: 20px;
            box-shadow: 0 8px 40px rgba(0,0,0,0.08), 0 0 0 1px rgba(212,168,83,0.15);
        }
        .right-panel .diagram-card #diagram-zone {
            width: 100% !important;
            height: 100% !important;
            min-height: 680px;
        }
        .right-panel .diagram-card #diagram-panel {
            width: 100% !important;
            height: 100% !important;
        }
        .right-panel .diagram-card #prog-diagram {
            width: 100% !important;
            height: 100% !important;
            max-height: 920px;
        }
        {% endif %}

        /* ── 2-Phase Scene Layout System ─────────────────────────── */
        /* Phase 1 (default): Bullets visible, diagram card hidden   */
        /* Phase 2 (diagram-phase): Bullets fade, diagram fills panel */

        /* slide-container is just a wrapper — panels use absolute positioning from _base.css.j2 */
        #slide-container {
          width: 1920px;
          height: 1080px;
          position: relative;
        }

        /* ── Diagram Card — initially a floating card ── */
        .diagram-card {
            position: absolute;
            right: 28px;
            top: 50%;
            transform: translateY(-52%) translateX(30px);
            width: 520px;
            height: 400px;
            opacity: 0;
            transition: all 0.6s cubic-bezier(0.23, 1, 0.32, 1);
            z-index: 30;
        }

        /* ── DIAGRAM PHASE — Full Panel Takeover ── */
        #right-panel.diagram-phase .bullets-zone {
            opacity: 0 !important;
            max-height: 0 !important;
            overflow: hidden !important;
            pointer-events: none !important;
            transition: opacity 0.5s ease, max-height 0.6s ease 0.1s;
        }
        #right-panel.diagram-phase .slide-heading-right,
        #right-panel.diagram-phase .gold-divider {
            opacity: 0.3 !important;
            transition: opacity 0.4s ease;
        }

        #right-panel.diagram-phase .diagram-card {
            position: relative !important;
            width: 100% !important;
            height: 82% !important;
            max-height: none !important;
            right: auto !important;
            top: auto !important;
            transform: none !important;
            opacity: 1 !important;
            margin-top: 12px;
            border-radius: 20px;
            box-shadow: 0 8px 40px rgba(0,0,0,0.08), 0 0 0 1px rgba(212,168,83,0.15);
        }

        #right-panel.diagram-phase #diagram-zone {
            width: 100% !important;
            height: 100% !important;
            min-height: 600px;
        }

        #right-panel.diagram-phase #diagram-panel {
            width: 100% !important;
            height: 100% !important;
        }

        #right-panel.diagram-phase #diagram-panel svg,
        #right-panel.diagram-phase #prog-diagram {
            width: 100% !important;
            height: 100% !important;
            max-height: 860px;
        }

        /* V15: Active speaker bar — pulsing left-edge glow on narrated bullet */
        .speaker-bar {
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            background: linear-gradient(180deg, #FFD700 0%, #FF8C00 100%);
            border-radius: 2px;
            box-shadow: 0 0 12px rgba(255, 215, 0, 0.6), 0 0 24px rgba(255, 140, 0, 0.3);
            animation: speaker-bar-pulse 1.2s ease-in-out infinite alternate;
            z-index: 5;
        }
        @keyframes speaker-bar-pulse {
            0%   { opacity: 0.7; box-shadow: 0 0 8px rgba(255, 215, 0, 0.4); }
            100% { opacity: 1.0; box-shadow: 0 0 18px rgba(255, 215, 0, 0.8), 0 0 36px rgba(255, 140, 0, 0.4); }
        }
        .bullet { position: relative; } /* ensure speaker-bar is positioned relative to bullet */

        /* V15: Cursor dot for diagram annotation tracking */
        .cursor-dot {
            position: absolute;
            pointer-events: none;
            z-index: 60;
            transition: left 0.5s cubic-bezier(0.25, 0.1, 0.25, 1), top 0.5s cubic-bezier(0.25, 0.1, 0.25, 1);
        }
        .cursor-ring {
            width: 28px;
            height: 28px;
            border: 2px solid rgba(0, 229, 255, 0.6);
            border-radius: 50%;
            position: absolute;
            top: -14px;
            left: -14px;
            animation: cursor-ring-pulse 1.5s ease-in-out infinite;
        }
        .cursor-center {
            width: 8px;
            height: 8px;
            background: #FF6B35;
            border-radius: 50%;
            position: absolute;
            top: -4px;
            left: -4px;
            box-shadow: 0 0 8px rgba(0, 229, 255, 0.8);
        }
        @keyframes cursor-ring-pulse {
            0%   { transform: scale(1); opacity: 0.6; }
            50%  { transform: scale(1.3); opacity: 0.3; }
            100% { transform: scale(1); opacity: 0.6; }
        }
    </style>
    {% include '_gsap_head.html.j2' %}
</head>
<body class="{{ 'has-diagram' if scene.diagram_paths else '' }}">

<!-- ── TIMELINE DATA (injected by Python before page load) ── -->
<script>
// ── Safety: SCENE_FINISHED failsafe ──────────────────────────
(function() {
  // Guarantee SCENE_FINISHED is always set eventually
  var _sceneDuration = {{ scene_audio_duration_ms | default(45000) }};
  var _safetyTimeout = Math.min(_sceneDuration + 5000, 60000);
  
  // Hard failsafe: set SCENE_FINISHED after scene duration + 5s no matter what
  setTimeout(function() {
    if (!window.SCENE_FINISHED) {
      console.warn('[Safety] SCENE_FINISHED forced by safety timeout at ' + _safetyTimeout + 'ms');
      window.SCENE_FINISHED = true;
    }
  }, _safetyTimeout);
  
  // Catch any uncaught errors and still finish
  window.addEventListener('error', function(e) {
    console.error('[JS Error]', e.message, 'at', e.filename + ':' + e.lineno);
    // After error, wait 2s then force finish to allow partial recording
    if (!window.SCENE_FINISHED) {
      setTimeout(function() {
        window.SCENE_FINISHED = true;
      }, 2000);
    }
  });
})();

    window.TIMELINE_DATA = {{ timeline_data | tojson }};
    window.DIAGRAM_DATA = {{ scene.diagram_data | default({}) | tojson }};
    window.WORD_TIMESTAMPS = {{ word_timestamps | tojson }};
    window.AUDIO_EL = null; // Set by Playwright or audio element if present
</script>

<!-- ── Analogy background overlay ── -->
<div id="analogy-overlay"></div>

<div id="slide-container">
<!-- ════════════════════════════════════════════════════════
     LEFT PANEL — Navy
════════════════════════════════════════════════════════ -->
{% if (show_left_panel is not defined or show_left_panel) and not diagram_fullscreen %}
<div class="left-panel" id="left-panel">

    <div class="topic-chip" id="topic-chip">{{ scene.topic }}</div>

    <h1 class="slide-heading playfair" id="heading-left">
        {% set heading = scene.heading_left %}
        {% if scene.gold_word %}
            {% set heading = heading | replace(scene.gold_word,
                '<span class="gold-word">' ~ scene.gold_word ~ '</span>', 1) %}
        {% endif %}
        {{ heading | safe }}
    </h1>

    <p class="slide-description inter" id="left-desc">
        {{ scene.left_description or '' }}
    </p>

    <!-- V16: Summary Strip -->
    <div class="summary-strip" id="summary-strip">
        <span class="summary-strip-icon">📌</span>
        <span class="summary-strip-text">{{ scene.takeaway }}</span>
    </div>

    <div class="scene-counter">
        Scene {{ "%02d"|format(scene.scene_index) }} /
        {{ "%02d"|format(scene.total_scenes) }}
    </div>
</div>
{% endif %}

<!-- ════════════════════════════════════════════════════════
     RIGHT PANEL — Cream
════════════════════════════════════════════════════════ -->
<div class="right-panel" id="right-panel">

    <!-- Progress strip -->
    <div class="progress-strip">
        <div class="progress-fill"
             style="width:{{ (scene.scene_index / scene.total_scenes * 100)|round }}%;"></div>
    </div>

    <!-- Sub-heading -->
    <h2 class="slide-heading-right playfair" id="heading-right">
        {{ scene.heading_right }}
    </h2>
    <div class="gold-divider"></div>

    <!-- Bullets (V16: conditionally shown based on scene_mode) -->
    {% if show_bullets is not defined or show_bullets %}
    <div class="bullets-zone" id="bullets-zone">
        {% for bullet in scene.bullets %}
        {% if bullet is mapping %}
        <div class="bullet" data-index="{{ loop.index0 }}" id="bullet_{{ scene.scene_index }}_{{ loop.index0 }}">
            <div class="bullet-num">{{ bullet.num or "%02d"|format(loop.index) }}</div>
            <div class="bullet-text inter">
                {% set btext = bullet.text or '' %}
                {% if bullet.zoom_word %}
                    {% set btext = btext | replace(bullet.zoom_word,
                        '<span class="zoom-word-inline" id="zw_' ~ loop.index0 ~ '">'
                        ~ bullet.zoom_word ~ '</span>', 1) %}
                {% endif %}
                {{ btext | wordwrap_spans | safe }}
            </div>
        </div>
        {% else %}
        <div class="bullet" data-index="{{ loop.index0 }}" id="bullet_{{ scene.scene_index }}_{{ loop.index0 }}">
            <div class="bullet-num">{{ "%02d"|format(loop.index) }}</div>
            <div class="bullet-text inter">{{ bullet | wordwrap_spans | safe }}</div>
        </div>
        {% endif %}
        {% endfor %}
    </div>
    {% endif %}

    <!-- ── DIAGRAM CARD (always rendered, fades in via JS event) ── -->
    {% if scene.diagram_paths or scene._programmatic_svg or scene.diagram_refs %}
    <div id="diagram-card" class="diagram-card">

        <!-- Mac-style header strip -->
        <div class="diagram-card-header">
            <div class="diagram-dot red"></div>
            <div class="diagram-dot amber"></div>
            <div class="diagram-dot green"></div>
            <span style="margin-left:8px;">Diagram</span>
        </div>

        <!-- DIAGRAM ZONE — Layered (replaces simple img tag) -->
        <div id="diagram-zone" class="diagram-zone {% if not (scene.diagram_paths or scene._programmatic_svg or scene.diagram_refs) %}diagram-hidden{% endif %}">
        
          <!-- Wrapper handles CSS zoom transforms -->
          <div id="diagram-wrapper" class="diagram-wrapper" style="overflow:hidden;">
            <div id="diagram-zoom-target" style="position:relative; width:100%; height:100%; display:flex; align-items:center; justify-content:center;">
              {% if scene._programmatic_svg %}
              <div id="diagram-panel" style="
                width: 100%;
                height: 100%;
                min-height: 420px;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 16px;
                box-sizing: border-box;
              ">
                <div style="
                  width: 100%;
                  height: 100%;
                  display: flex;
                  align-items: center;
                  justify-content: center;
                  background: rgba(255,255,255,0.03);
                  border-radius: 12px;
                  padding: 12px;
                ">
                  {{ scene._programmatic_svg | safe }}
                </div>
              </div>
              {% elif scene.diagram_refs or scene.diagram_paths %}
              <div id="diagram-panel" style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;padding:16px;">
                <div id="diagram-zoom-wrapper" style="position:relative;transform-origin:center center;width:100%;height:100%;">
                  <img id="diagram-img"
                       src="{{ scene.diagram_refs[0] if scene.diagram_refs else scene.diagram_paths[0] }}"
                       style="max-width:100%;max-height:100%;display:block;object-fit:contain;border-radius:8px;"/>
                  <svg id="annotation-svg" style="position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:200;overflow:visible;"></svg>
                  <div id="cursor-dot" style="position:fixed;width:18px;height:18px;border-radius:50%;background:rgba(0,229,255,0.92);box-shadow:0 0 0 5px rgba(0,229,255,0.2);pointer-events:none;z-index:999;opacity:0;transform:translate(-50%,-50%);"></div>
                </div>
              </div>
              {% endif %}
            </div>
          </div>
        
          <!-- For table type diagrams — rendered as HTML not image -->
          {% if scene.diagram_type == 'table' and scene.table_data %}
          <div class="diagram-table-wrap">
            <table class="diagram-table">
              <thead>
                <tr>{% for h in scene.table_data.headers %}<th>{{ h }}</th>{% endfor %}</tr>
              </thead>
              <tbody>
                 {% for row in scene.table_data.rows %}
                 <tr class="tbl-row" data-row="{{ loop.index0 }}">
                   {% for cell in row %}<td>{{ cell }}</td>{% endfor %}
                 </tr>
                 {% endfor %}
              </tbody>
            </table>
          </div>
          {% endif %}
        
        </div>
        
        <!-- Init overlays to match image dimensions -->
        <script>
        function initDiagramOverlays(img) {
          const canvas = document.getElementById('diagram-canvas-overlay');
          const svg = document.getElementById('diagram-svg-overlay');
          const annLayer = document.getElementById('annotation-layer');
          const w = img.offsetWidth, h = img.offsetHeight;
          if (canvas) {
              canvas.width = img.naturalWidth;
              canvas.height = img.naturalHeight;
              canvas.style.width = w + 'px';
              canvas.style.height = h + 'px';
          }
          if (svg) {
              svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
              svg.style.width = w + 'px';
              svg.style.height = h + 'px';
          }
          if (annLayer) {
              annLayer.setAttribute('viewBox', `0 0 ${w} ${h}`);
              annLayer.style.width = w + 'px';
              annLayer.style.height = h + 'px';
              // Reposition annotation elements to center of actual image
              const circle = document.getElementById('annotation-circle');
              const arrow = document.getElementById('annotation-arrow');
              if (circle) { circle.setAttribute('cx', w/2); circle.setAttribute('cy', h/2); circle.setAttribute('r', Math.min(w,h)*0.2); }
              if (arrow) { arrow.setAttribute('d', `M ${w/2} ${h*0.3} Q ${w*0.6} ${h*0.1} ${w*0.8} ${h*0.2}`); }
          }
        }
        </script>
    </div>
    {% endif %}

    <!-- Takeaway bar -->
    <div id="takeaway-bar">
        <span class="takeaway-icon">💡</span>
        <span class="takeaway-label inter">Key Takeaway</span>
        <span class="takeaway-text inter">{{ scene.takeaway }}</span>
    </div>
</div>
</div>

<!-- ════════════════════════════════════════════════════════
     AVATAR
════════════════════════════════════════════════════════ -->
{% if not hide_avatar %}
{% if scene.avatar_path %}
    {% set avatar_cfg = avatar_config | default({}) %}
    {% set is_hidden = avatar_cfg.hidden_for_ffmpeg | default(False) %}
    {% set avatar_size = avatar_cfg.size | default(120) %}
    {% set ring_color = avatar_cfg.ring | default('#4A90D9') %}
    <div id="avatar-ring" style="position: absolute; border: 2px solid {{ ring_color }}; border-radius: 50%; opacity: 0; pointer-events: none; z-index: 50; width: {{ avatar_size + 18 }}px; height: {{ avatar_size + 18 }}px; left: calc(var(--col-left, 39.58%) / 2 - {{ (avatar_size + 18) // 2 }}px); bottom: 19px; display: {{ 'none' if is_hidden else 'block' }};"></div>
    <img id="avatar" src="{{ scene.avatar_path }}" alt="Instructor" style="position: absolute; border-radius: 50%; object-fit: cover; opacity: {{ 0 if is_hidden else 1 }}; pointer-events: none; z-index: 50; width: {{ avatar_size }}px; height: {{ avatar_size }}px; left: calc(var(--col-left, 39.58%) / 2 - {{ avatar_size // 2 }}px); bottom: 28px; border: 3px solid #C9B99A; display: {{ 'none' if is_hidden else 'block' }};" />
{% endif %}
{% endif %}

<!-- Scene Transition Flash -->
<div id="scene-flash" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: white; opacity: 0; pointer-events: none; z-index: 9999;"></div>


<!-- NOTE: Subtitles are burned by FFmpeg SRT (synced with audio) -->

<!-- V12.5 Teacher Draw Layers -->
{% include '_gsap_layers.html.j2' %}

<!-- ── Diagram expansion controller ────────────────────────── -->
<script>
window.DiagramExpansion = {
  _expanded: false,
  _timer: null,
  
  expandForDiagram: function(delayMs) {
    // Widen right panel for diagram focus
    clearTimeout(this._timer);
    var leftPanel = document.getElementById('left-panel');
    var rightPanel = document.getElementById('right-panel');
    if (!leftPanel || !rightPanel) return;
    
    this._timer = setTimeout(function() {
      leftPanel.style.width = '20%';
      rightPanel.style.left = '20%';
      rightPanel.style.width = '80%';
      window.DiagramExpansion._expanded = true;
    }, delayMs || 0);
  },
  
  expandFull: function() {
    // Full expansion — left panel hides, right takes over
    var leftPanel = document.getElementById('left-panel');
    var rightPanel = document.getElementById('right-panel');
    if (!leftPanel || !rightPanel) return;
    leftPanel.style.opacity = '0';
    leftPanel.style.pointerEvents = 'none';
    rightPanel.style.left = '0';
    rightPanel.style.width = '100%';
    this._expanded = true;
  },
  
  collapse: function() {
    // Return to normal layout
    var leftPanel = document.getElementById('left-panel');
    var rightPanel = document.getElementById('right-panel');
    if (!leftPanel || !rightPanel) return;
    leftPanel.style.width = '';
    leftPanel.style.opacity = '';
    leftPanel.style.pointerEvents = '';
    rightPanel.style.left = '';
    rightPanel.style.width = '';
    this._expanded = false;
  }
};
</script>

<!-- ── V12.5 GSAP Timeline Engine ── -->
<script>
    {% include '_diagram_helpers.js.j2' %}
    {% include '_timeline_engine.js.j2' %}
</script>

</body>
</html>
